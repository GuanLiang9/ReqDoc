# Copy to .env (setup.ps1 does this for you)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=16384
# Leave unset to use the GPU if there is one. Set to 0 to force CPU
# (needed if Ollama crashes with a CUDA error, e.g. on some new NVIDIA laptop GPUs)
# OLLAMA_NUM_GPU=0
OLLAMA_MAX_TOKENS=4096
# Port for the website (change it if 8000 is already used by another program)
REQDOC_PORT=8000
# Speech-to-text for recordings: tiny / base / small / medium (bigger = more accurate, slower)
WHISPER_MODEL=small
WHISPER_LANGUAGE=en
CHUNK_TOKENS=6000
REQDOC_DATA_DIR=./data
GLOSSARY_FILE=./config/glossary.txt
